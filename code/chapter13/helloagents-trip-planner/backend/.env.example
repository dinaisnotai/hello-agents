APP_NAME=Constraint-Aware Trip Planner
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If omitted, the planner uses local fallback POIs and route estimates.
AMAP_API_KEY=
AMAP_TIMEOUT_SECONDS=8

# Optional for future LLM reviewer extensions.
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Optional. RAG uses an OpenAI-compatible /embeddings endpoint. When
# EMBEDDING_API_KEY and EMBEDDING_BASE_URL are blank, it falls back to
# LLM_API_KEY/OPENAI_API_KEY and OPENAI_BASE_URL respectively.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
LOG_LEVEL=INFO

# SQLite database used for trip sessions and plan version history.
TRIP_SESSION_DB_PATH=
