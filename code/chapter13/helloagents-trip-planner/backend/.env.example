APP_NAME=Constraint-Aware Trip Planner
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If omitted, the planner uses local fallback POIs and route estimates.
AMAP_API_KEY=
AMAP_TIMEOUT_SECONDS=8

# Optional for future LLM reviewer extensions.
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# RAG uses an OpenAI-compatible /embeddings endpoint. The following model and
# endpoint work with Volcengine Ark. Create your own key; never commit it.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215

UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
LOG_LEVEL=INFO
# Detailed POI/weather/hotel Agent payloads and raw AMap responses are off by
# default. PlannerAgent keeps concise LLM timing logs at INFO.
AGENT_LOG_OUTPUTS=false
AMAP_LOG_RAW_RESPONSE=false
# Concise LangGraph node transitions. This never includes raw map payloads.
LANGGRAPH_TRACE_LOGS=true

# SQLite database used for trip sessions and plan version history.
TRIP_SESSION_DB_PATH=

# Default: evidence-guided Agents plus deterministic planning and bounded repair.
WORKFLOW_MODE=langgraph
# Optional. Defaults to backend/data/langgraph_checkpoints.db.
LANGGRAPH_CHECKPOINT_DB_PATH=
# When true, LangGraph may use the configured LLM to supplement free text.
ENABLE_LLM_INTENT_PARSING=false

# Optional read-only hotel content and date-specific rates integration.
# Free sandbox signup: https://dashboard.liteapi.travel/
# Set provider=liteapi after filling the key. Sandbox results are labelled.
HOTEL_API_PROVIDER=none
LITEAPI_API_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_ENVIRONMENT=sandbox

# CNY planning allowances, NOT official local tariffs or supplier quotations.
# Taxi: base + max(0, km - included_km) * per_km, per vehicle per leg.
TAXI_BASE_FARE=15
TAXI_INCLUDED_KM=3
TAXI_PER_KM=3
TRANSIT_FARE_PER_LEG=6
DRIVING_COST_PER_KM=0.7
PARKING_PER_DAY=50
# Set a nonzero toll allowance if needed; actual tolls are not queried.
TOLL_PER_KM=0
RENTAL_PER_DAY=300
RENTAL_INSURANCE_PER_DAY=60
VEHICLE_CAPACITY=4
